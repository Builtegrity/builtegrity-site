{
  "name": "builtegrity-transaction-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply builtegrity-v1 --local",
    "db:migrate:remote": "wrangler d1 migrations apply builtegrity-v1 --remote",
    "db:seed:local": "wrangler d1 execute builtegrity-v1 --local --file=transaction-engine/seed-tx-0001.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
