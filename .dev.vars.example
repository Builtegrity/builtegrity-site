# Copy to .dev.vars for local development. Never commit real secrets.

# Stripe
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_CONNECT_CLIENT_ID=ca_REPLACE_ME

# QuickBooks Online company books
# Create an Intuit Developer app with the QuickBooks Accounting scope.
QUICKBOOKS_CLIENT_ID=REPLACE_ME
QUICKBOOKS_CLIENT_SECRET=REPLACE_ME
# Base64 of exactly 32 random bytes. Used only to AES-GCM encrypt QuickBooks OAuth tokens stored in D1.
ACCOUNTING_TOKEN_ENCRYPTION_KEY_B64=REPLACE_32_BYTE_BASE64_KEY

# Clerk
# CLERK_JWT_KEY is the PEM public JWT verification key from Clerk. It is not a password,
# but keep environment-specific configuration out of source control anyway.
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----

# Resend
RESEND_API_KEY=re_REPLACE_ME
# Created with the production Resend webhook after the Worker endpoint is deployed.
# Used to verify svix-id / svix-timestamp / svix-signature on statement delivery events.
RESEND_WEBHOOK_SECRET=whsec_REPLACE_ME

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=REPLACE_ME

# Optional local-only portability fallback if deliberately setting AUTH_PROVIDER=OWNER_SESSION:
# OWNER_PASSWORD=replace-with-a-strong-owner-password
# OWNER_SESSION_SECRET=replace-with-a-long-random-session-secret
