name = "builtegrity-transaction-engine"
main = "worker/src/runtime.js"
compatibility_date = "2026-10-11"

[assets]
directory = "./public"
binding = "ASSETS"

[[d1_databases]]
binding = "DB"
database_name = "builtegrity-v1"
database_id = "REPLACE_AFTER_D1_CREATION"
migrations_dir = "migrations"

# Durable object storage for transaction PDFs, immutable statements, tax-support PDFs,
# hashed raw QuickBooks report snapshots, and preserved legal-notice evidence.
[[r2_buckets]]
binding = "TRANSACTION_RECORDS"
bucket_name = "builtegrity-transaction-records"

# The 2-minute loop rechecks local integrity status. The 10-minute watchdog runs
# safety checks, statements, tax-document delivery, company-books
# freshness/reconciliation, tax-workpaper readiness, watchdog routing, and legal-incident response.
# Expensive accounting API syncs are internally throttled and do not run every 15 minutes.
# Cloudflare cron is UTC.
[triggers]
crons = ["*/2 * * * *", "*/10 * * * *", "17 13 * * *"]

[vars]
APP_BASE_URL = "https://builtegrity.com"
ADMIN_BASE_URL = "https://admin.builtegrity.com"
ADMIN_HOSTNAME = "admin.builtegrity.com"
DEV_MODE = "false"

# QuickBooks Online read-only company-books adapter.
# Register this redirect URI in the Intuit app:
# https://admin.builtegrity.com/api/accounting/quickbooks/callback
QUICKBOOKS_CLIENT_ID = "REPLACE_ME"
# QUICKBOOKS_CLIENT_SECRET and ACCOUNTING_TOKEN_ENCRYPTION_KEY_B64 must be Worker secrets,
# never plaintext vars committed to source control.

# PDF cost estimates are stored in transaction economics as ESTIMATED, never mislabeled as actual.
# $1.00 = 1,000,000 micros. Tune these from observed production usage.
PDF_GENERATION_COST_MICROS = "50"
PDF_CACHE_HIT_COST_MICROS = "5"

# Watchdog stage controls which configuration omissions count as failures.
# Keep PREVIEW until provider accounts are created; then advance TEST -> PILOT -> LIVE.
WATCHDOG_STAGE = "PREVIEW"
# Use the monitored Builtegrity mailbox as the sender so replies cannot disappear into
# an unmonitored automation-only local part. The display name identifies the message type.
ALERT_EMAIL_FROM = "Builtegrity Watchdog <hello@builtegrity.com>"
ALERT_EMAIL_TO = "REPLACE_OWNER_EMAIL"

# Monthly merchant/partner statement delivery. This must be a verified Resend sender.
# hello@builtegrity.com is also the monitored customer-reply mailbox.
STATEMENT_EMAIL_FROM = "Builtegrity Statements <hello@builtegrity.com>"

# Legal incident intake. Use a dedicated receiving subdomain so Resend MX records do not
# interfere with the primary Google Workspace/business-mail MX records for builtegrity.com.
# Example receiving address after Resend receiving is enabled for legal.builtegrity.com:
LEGAL_INBOX_ADDRESS = "notices@legal.builtegrity.com"
LEGAL_COUNSEL_EMAIL_FROM = "Builtegrity Legal Intake <hello@builtegrity.com>"
# RESEND_API_KEY and LEGAL_INBOX_WEBHOOK_SECRET are Worker secrets, never plaintext vars.
# LEGAL_INBOX_WEBHOOK_SECRET is the signing secret of the dedicated Resend webhook that receives
# email.received events at: https://builtegrity.com/api/webhooks/legal-inbox
# Standing counsel / insurer webhook bearer secrets, if used, are also Worker secrets whose env-key
# names are referenced by legal_response_providers.intake_secret_env_key.

# Primary application identity layer. Clerk proves identity only.
# D1 merchant_access / partner_access own tenancy, roles, and permissions.
AUTH_PROVIDER = "CLERK"
CLERK_PUBLISHABLE_KEY = "pk_test_REPLACE_ME"
CLERK_ISSUER = "https://REPLACE.clerk.accounts.dev"
CLERK_AUTHORIZED_PARTIES = "https://builtegrity.com,https://admin.builtegrity.com"
CLERK_ADMIN_USER_IDS = "user_REPLACE_OWNER_ID"
CLERK_SIGN_IN_URL = "https://REPLACE.accounts.dev/sign-in"
CLERK_USER_URL = "https://REPLACE.accounts.dev/user"

# Payment adapters. Square stays disabled until sandbox tests, payout/reversal review and owner approval.
STRIPE_CONNECT_CLIENT_ID = "ca_REPLACE_ME"
SQUARE_ENV = "sandbox"
SQUARE_APP_ID = "REPLACE_SQUARE_SANDBOX_APP_ID"
SQUARE_PAYMENT_LINKS_ENABLED = "false"
SQUARE_LIVE_ENABLED = "false"
SQUARE_RECONCILIATION_ENABLED = "false"  # Enable after verified Square Sandbox payout tests
SQUARE_WEBHOOK_NOTIFICATION_URL = "https://builtegrity.com/api/webhooks/square"
# Keep SQUARE_APP_SECRET, SQUARE_WEBHOOK_SIGNATURE_KEY and
# SQUARE_TOKEN_ENCRYPTION_KEY_B64 in Cloudflare Worker secrets.

# Optional merchant bank data connector. Gated until Plaid production pricing,
# data-retention terms, OAuth redirect, encryption and sandbox tests are approved.
# Bank arrival/posted details are omitted unless the merchant explicitly connects a bank.
BANK_SYNC_ENABLED = "false"
PLAID_ENV = "sandbox"
PLAID_WEBHOOK_URL = "https://builtegrity.com/api/webhooks/plaid"
PLAID_REDIRECT_URI = "https://builtegrity.com/merchant/bank/"
# Keep PLAID_CLIENT_ID, PLAID_SECRET and BANK_TOKEN_ENCRYPTION_KEY_B64 as Worker secrets.
# Plaid Transactions may create a subscription charge per connected Item.

# Merchant-owned customer/transaction fields and optional outbound data feeds.
# File imports and field definitions require an authenticated merchant OWNER.
# Push feeds remain off until validated with a specific merchant sender/adapter.
CUSTOM_SYNC_ENABLED = "false"
# Throttled bank-permission and integration health notices are visible in the portal
# even when email delivery is off. Email delivery must use a verified Resend sender.
MERCHANT_SETUP_EMAILS_ENABLED = "false"
# Merchant Help request emails stay disabled until the owner verifies the Resend
# sender domain and supplies an authorized destination mailbox.
MERCHANT_HELP_EMAILS_ENABLED = "false"
# Store MERCHANT_HELP_EMAIL_FROM and MERCHANT_HELP_EMAIL_TO as deployment config.
# RESEND_API_KEY remains an encrypted Worker secret. No merchant bank secrets are
# required for Help requests.
MERCHANT_SETUP_EMAIL_FROM = "Builtegrity Setup <hello@builtegrity.com>"

# Public abuse protection. The site key is browser-safe; the secret key remains a Worker secret.
# Siteverify responses must report one of these hostnames before a public mutation is accepted.
TURNSTILE_SITE_KEY = "REPLACE_TURNSTILE_SITE_KEY"
TURNSTILE_ALLOWED_HOSTNAMES = "builtegrity.com"

# Optional defense-in-depth only. Cloudflare Access is NOT the primary product identity layer.
# AUTH_PROVIDER = "CLOUDFLARE_ACCESS"
# CF_ACCESS_TEAM_DOMAIN = "https://REPLACE.cloudflareaccess.com"
# CF_ACCESS_AUD = "REPLACE_ACCESS_APPLICATION_AUD"
# CF_ACCESS_ALLOWED_EMAILS = ""
